# EcoSaver Platform - Production Environment Configuration

# ======================================
# 🔐 SECURITY & AUTHENTICATION
# ======================================
JWT_SECRET=your-super-secure-jwt-secret-key-here-min-64-chars-recommended
JWT_REFRESH_SECRET=your-refresh-token-secret-different-from-jwt-secret
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-for-express-sessions

# ======================================
# 📧 EMAIL CONFIGURATION
# ======================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-ecosaver-platform@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM_NAME=EcoSaver Platform

# ======================================
# 🗄️ DATABASE CONFIGURATION
# ======================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecosaver?retryWrites=true&w=majority
MONGODB_DB_NAME=ecosaver_production

# Redis for session storage and caching
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# ======================================
# 🌍 FRONTEND CONFIGURATION
# ======================================
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ======================================
# 🤖 AI & VERIFICATION SERVICES
# ======================================
# Google Cloud Vision API
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_VISION_API_KEY=your-google-vision-api-key
GOOGLE_APPLICATION_CREDENTIALS=./config/google-cloud-credentials.json

# OpenAI API for advanced AI features
OPENAI_API_KEY=your-openai-api-key

# Custom AI Verification Service
AI_VERIFICATION_ENDPOINT=https://api.your-ai-service.com/v1
AI_VERIFICATION_API_KEY=your-ai-verification-key

# Weather API for environmental context
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ======================================
# 🌱 ENVIRONMENTAL PARTNERSHIPS
# ======================================
# One Tree Planted Partnership
ONE_TREE_PLANTED_API_KEY=your-onetreeplanted-api-key
ONE_TREE_PLANTED_WEBHOOK_SECRET=your-webhook-secret

# Offset.earth Carbon Offset Partnership  
OFFSET_EARTH_API_KEY=your-offsetearth-api-key
OFFSET_EARTH_WEBHOOK_SECRET=your-webhook-secret

# Ecosia Integration
ECOSIA_API_KEY=your-ecosia-integration-key

# Ocean Cleanup Partnership
OCEAN_CLEANUP_API_KEY=your-oceancleanup-api-key
OCEAN_CLEANUP_WEBHOOK_SECRET=your-webhook-secret

# WWF Partnership
WWF_API_KEY=your-wwf-partnership-key
WWF_WEBHOOK_SECRET=your-webhook-secret

# ======================================
# 💳 PAYMENT PROCESSING
# ======================================
# Stripe for donations and premium features
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PayPal integration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ======================================
# 📱 THIRD-PARTY INTEGRATIONS
# ======================================
# Social Media APIs for sharing
FACEBOOK_APP_ID=your-facebook-app-id
TWITTER_API_KEY=your-twitter-api-key
INSTAGRAM_ACCESS_TOKEN=your-instagram-token

# Push Notifications
FIREBASE_SERVER_KEY=your-firebase-server-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ======================================
# 🔍 MONITORING & ANALYTICS
# ======================================
# Application Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
NEW_RELIC_APP_NAME=EcoSaver-Production

# Log Management
LOGGLY_TOKEN=your-loggly-token
LOGGLY_SUBDOMAIN=your-loggly-subdomain

# ======================================
# ☁️ CLOUD SERVICES
# ======================================
# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ecosaver-uploads
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,video/mp4

# ======================================
# 🌐 CDN & STATIC ASSETS
# ======================================
CDN_URL=https://cdn.your-domain.com
STATIC_ASSETS_URL=https://assets.your-domain.com

# ======================================
# 🔧 APPLICATION CONFIGURATION
# ======================================
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.your-domain.com
API_VERSION=v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true

# ======================================
# 🎮 GAMIFICATION & REWARDS
# ======================================
# EcoCoins Exchange Rate (1 USD = X EcoCoins)
ECOCOINS_EXCHANGE_RATE=100

# Achievement System
ACHIEVEMENT_MULTIPLIER=1.0
LEADERBOARD_UPDATE_INTERVAL=300000

# Challenge System
DAILY_CHALLENGE_RESET_TIME=00:00
WEEKLY_CHALLENGE_RESET_DAY=monday

# ======================================
# 🚨 SECURITY CONFIGURATION
# ======================================
# CORS Configuration
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Helmet Security Headers
HELMET_CONTENT_SECURITY_POLICY=true
HELMET_CROSSDOMAIN_POLICY=true

# Rate Limiting
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_LOCKOUT_DURATION=1800000

# Password Policy
MIN_PASSWORD_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# ======================================
# 🌱 ENVIRONMENTAL DATA
# ======================================
# Carbon Footprint Calculation APIs
CARBON_INTERFACE_API_KEY=your-carbon-interface-key
EPA_API_KEY=your-epa-api-key

# Real-time Environmental Data
AIR_QUALITY_API_KEY=your-airquality-api-key
SUSTAINABILITY_DATA_API=your-sustainability-api-key

# ======================================
# 📊 DATABASE OPTIMIZATION
# ======================================
# Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_CONNECTION_TIMEOUT=30000

# Caching Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ======================================
# 🔄 BACKUP & DISASTER RECOVERY
# ======================================
# Database Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=ecosaver-backups

# ======================================
# 📈 SCALING CONFIGURATION
# ======================================
# Load Balancer Health Check
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_INTERVAL=30

# Auto-scaling Triggers
CPU_THRESHOLD=70
MEMORY_THRESHOLD=80
RESPONSE_TIME_THRESHOLD=2000

# ======================================
# 🔧 DEVELOPMENT & TESTING
# ======================================
# Only uncomment for development/staging environments
# DEBUG=ecosaver:*
# LOG_LEVEL=debug
# ENABLE_SWAGGER_DOCS=true

# Testing Configuration
# TEST_DATABASE_URL=mongodb://localhost:27017/ecosaver_test
# MOCK_EXTERNAL_APIS=false

# ======================================
# 💡 CUSTOM FEATURES
# ======================================
# Community Features
ENABLE_FORUMS=true
ENABLE_CHAT=true
ENABLE_VIDEO_CALLS=false

# Advanced Features
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_OFFLINE_MODE=true
ENABLE_PWA=true

# Localization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,hi,zh

# ======================================
# 🎯 BUSINESS METRICS
# ======================================
# Revenue Tracking
ENABLE_REVENUE_TRACKING=true
CONVERSION_TRACKING_ID=your-conversion-tracking-id

# A/B Testing
OPTIMIZELY_PROJECT_ID=your-optimizely-project-id

# Customer Support
ZENDESK_SUBDOMAIN=your-zendesk-subdomain
ZENDESK_API_TOKEN=your-zendesk-token

# ======================================
# 🌟 PREMIUM FEATURES
# ======================================
# Subscription Management
PREMIUM_MONTHLY_PRICE=9.99
PREMIUM_YEARLY_PRICE=99.99
TRIAL_PERIOD_DAYS=14

# Enterprise Features
ENTERPRISE_API_RATE_LIMIT=1000
ENTERPRISE_SUPPORT_PRIORITY=high

# ======================================
# 📱 MOBILE APP CONFIGURATION
# ======================================
# App Store Configuration
IOS_APP_STORE_ID=your-ios-app-id
ANDROID_PACKAGE_NAME=com.ecosaver.app

# Deep Linking
UNIVERSAL_LINK_DOMAIN=ecosaver.app
CUSTOM_URL_SCHEME=ecosaver

# ======================================
# 🔐 COMPLIANCE & LEGAL
# ======================================
# GDPR Compliance
ENABLE_GDPR_MODE=true
DATA_RETENTION_PERIOD=730

# Privacy Policy
PRIVACY_POLICY_URL=https://your-domain.com/privacy
TERMS_OF_SERVICE_URL=https://your-domain.com/terms

# Cookie Consent
COOKIE_CONSENT_REQUIRED=true
ANALYTICS_COOKIES_ENABLED=true