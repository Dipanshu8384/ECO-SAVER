# Environment Configuration for EcoSaver Backend

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ecosaver_production
# For production, use: mongodb+srv://username:password@cluster.mongodb.net/ecosaver

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRY=7d

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=localhost

# Security Keys
ENCRYPTION_KEY=your_32_character_encryption_key_here
BCRYPT_ROUNDS=12

# Third-Party API Keys

# Google Cloud APIs (for AI verification)
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_VISION_API_KEY=your_vision_api_key
GOOGLE_CLOUD_STORAGE_BUCKET=ecosaver_images

# Environmental Partnership APIs
ONE_TREE_PLANTED_API_KEY=your_tree_planting_api_key
ONE_TREE_PLANTED_ENDPOINT=https://api.onetreeplanted.org/v1

OFFSET_EARTH_API_KEY=your_carbon_offset_api_key
OFFSET_EARTH_ENDPOINT=https://api.offset.earth/v1

ECOSIA_PARTNERSHIP_KEY=your_ecosia_api_key

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Service (SendGrid/NodeMailer)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@ecosaver.app
EMAIL_SUPPORT=support@ecosaver.app

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Redis Configuration (for session management and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf
UPLOAD_DIRECTORY=uploads/

# Social Media Integration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# Push Notifications
FCM_SERVER_KEY=your_firebase_server_key
APNS_KEY=your_apple_push_key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/ecosaver.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=https://ecosaver.app,https://www.ecosaver.app
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=your_session_secret_key_change_this
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_MAX_AGE=86400000

# Environment Specific URLs
CLIENT_URL=https://ecosaver.app
API_BASE_URL=https://api.ecosaver.app

# Monitoring and Health Checks
HEALTH_CHECK_ENDPOINT=/health
METRICS_ENDPOINT=/metrics
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=backups/