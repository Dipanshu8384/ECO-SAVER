
# 🌱 ECOSAVER ENTERPRISE ENVIRONMENT VARIABLES
# Copy these to Railway's environment variables section:

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecosaver
JWT_SECRET=your-ultra-secure-jwt-secret-key-32-characters-minimum
BCRYPT_ROUNDS=12

# AI Systems  
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key
OPENAI_API_KEY=your-openai-api-key

# Environmental Partnerships
ONE_TREE_PLANTED_API_KEY=your-tree-planting-api
OFFSET_EARTH_API_KEY=your-carbon-offset-api
OCEAN_CLEANUP_API_KEY=your-ocean-cleanup-api
WWF_PARTNERSHIP_KEY=your-wwf-partnership-key

# Payment Processing
STRIPE_SECRET_KEY=sk_live_your-stripe-secret
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-public

# Email System
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Server Configuration
NODE_ENV=production
PORT=3000
