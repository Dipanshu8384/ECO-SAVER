# EcoSaver - Production Deployment Configuration
# This maintains your beautiful frontend while adding backend power!

# Environment Variables
NODE_ENV=production
PORT=3000

# Database Configuration
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/ecosaver?retryWrites=true&w=majority

# JWT Secret (change this!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (for real OTP)
EMAIL_USER=your-ecosaver-email@gmail.com
EMAIL_PASS=your-app-specific-password

# API Keys for real environmental data
OPENWEATHER_API_KEY=your-openweather-api-key
NASA_API_KEY=your-nasa-api-key

# Security Settings
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# CORS Settings
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com